{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isokron-ai/tool-qa/blob/main/worker-kit/manifest.schema.json",
  "title": "tool-qa worker result manifest, schema version 1",
  "description": "manifest.json at the root of every worker result bundle. Only a subset of JSON Schema is used (see worker-kit/contract.mjs), so the schema can be checked without dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "fence", "run_key", "subject", "workflow",
    "tools", "oracles", "settings_manifest_digest", "started_at", "finished_at",
    "files", "skips", "controls"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt_id": { "$ref": "#/$defs/attempt_id" },
    "fence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "run_key": { "$ref": "#/$defs/sha256" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "sha"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\s]+$" },
        "repo": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
        "sha": { "type": ["string", "null"], "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "file", "sha", "run_id", "run_attempt"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
        "file": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]{1,100}\\.ya?ml$" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "run_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "run_attempt": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "tools": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/component" } },
    "oracles": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/component" } },
    "settings_manifest_digest": { "$ref": "#/$defs/sha256" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "$ref": "#/$defs/bundle_path" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 }
        }
      }
    },
    "skips": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "reason"],
        "properties": {
          "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "reason": {
            "enum": [
              "remote_only", "no_runnable_artifact", "unsupported_transport",
              "build_failed_upstream", "install_failed_registry",
              "start_requires_credentials", "no_local_backend", "heavy_backend",
              "timeout_start", "cluster_member", "quarantined", "lane_disabled",
              "policy_excluded", "trace_unavailable", "bridge_required",
              "rate_limited", "upstream_unavailable",
              "unsupported_language", "unsupported_layout", "reader_limit", "no_tools_found",
              "too_large", "tool_error"
            ]
          },
          "evidence": { "$ref": "#/$defs/bundle_path" },
          "retryable": { "type": "boolean" },
          "fault": { "enum": ["tool", "subject", "infra", "policy"] }
        }
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "expected", "observed"],
        "properties": {
          "kind": { "enum": ["known_good", "known_bad", "malicious", "protocol_variant", "forgery"] },
          "expected": { "$ref": "#/$defs/label" },
          "observed": { "$ref": "#/$defs/label" },
          "output": { "$ref": "#/$defs/bundle_path" },
          "marker": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
        }
      }
    }
  },
  "$defs": {
    "attempt_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "label": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9@/._-]{0,127}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+:_-]{0,127}$" }
      }
    },
    "bundle_path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(observations|results|controls|raw|logs)(/(?!\\.\\.?(/|$))[A-Za-z0-9._-]{1,100})+$"
    }
  }
}
