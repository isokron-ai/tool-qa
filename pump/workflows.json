      "sandbox_sha": "4c16b586e8e5886acb098285b6ec405fd4db4ac7",
      "repo": "isokron-ai/mcp-writecheck-action",
      "file": "corpus.yml",
      "ref": "main",
      "shard_size": 10,
      "setup_minutes": 12,
      "minutes_per_subject": 2,
      "slots_max": 2,
      "versions": { "tool": { "mcp-writecheck-action": "54d4541", "mcp-writecheck": "3af41c6" }, "oracle": {}, "probe": { "mcp-surface-corpus": "4c16b58" } },
      "image_digest": null,
      "settings_state": "default"
    },
    "meta-github": {
      "enabled": false,
      "runs_untrusted": false,
      "repo": "isokron-ai/tool-qa",
      "file": "meta-github.yml",
      "throttle_stages": ["known_answer", "graphql", "tag_refs", "contributors", "private_vulnerability_reporting", "branch_rules", "scorecard", "collect:reader_limit"],
      "ref": "main",
