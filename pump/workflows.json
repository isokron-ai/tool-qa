{
  "version": 1,
  "description": "Worker workflows the pump may dispatch. A workflow is dispatched only when enabled is true. versions, image_digest and settings_state go into every run_key, so changing any of them makes every subject due again for that workflow. Lease and slot expiry = 1.5 x (setup_minutes + shard_size x minutes_per_subject) + 10 minutes. slots_max caps open dispatches for the workflow. enabled and runs_untrusted must be true or false. runs_untrusted says whether the workflow runs third-party code (servers, builds); a workflow that does not say false counts as true, and none of those is dispatched while the sandbox breaker is open (pump/breaker.mjs, docs/OPERATIONS.md). sandbox_sha is the isokron-ai/mcp-surface-corpus commit such a workflow pins its sandbox at (null until it pins one); the watchdog shows amber while it differs from the commit the nightly conformance run tested. The worker contract is in docs/INTERFACES.md.",
  "workflows": {
    "scan-static": {
      "enabled": true,
      "runs_untrusted": false,
      "repo": "isokron-ai/mcp-check",
      "file": "scan-static.yml",
      "throttle_stages": ["static:rate_limited"],
      "ref": "main",
      "shard_size": 25,
      "setup_minutes": 3,
      "minutes_per_subject": 1,
      "slots_max": 3,
      "versions": { "tool": { "mcp-check": "75503c1" }, "oracle": {}, "probe": {} },
      "image_digest": null,
      "settings_state": "default"
    },
    "live-probe": {
      "enabled": true,
      "runs_untrusted": true,
      "sandbox_sha": "4c16b586e8e5886acb098285b6ec405fd4db4ac7",
      "repo": "isokron-ai/mcp-check",
      "file": "live-probe.yml",
      "ref": "main",
      "shard_size": 10,
      "setup_minutes": 8,
      "minutes_per_subject": 2,
      "slots_max": 12,
      "versions": { "tool": { "mcp-check": "116b0ca" }, "oracle": { "conformance": "0.2.0-alpha.12+f44482b", "sdk-typescript": "1.32.2", "client-typescript": "2.4.0", "sdk-python": "2.3.0", "sdk-go": "v1.8.0" }, "probe": { "mcp-surface-corpus": "4c16b58" } },
      "image_digest": null,
      "settings_state": "default"
    },
    "scan-deep": {
      "enabled": false,
      "runs_untrusted": true,
      "sandbox_sha": null,
      "repo": "isokron-ai/mcp-check",
      "file": "scan-deep.yml",
      "ref": "main",
      "shard_size": 2,
      "setup_minutes": 5,
      "minutes_per_subject": 30,
      "slots_max": 2,
      "versions": { "tool": {}, "oracle": {}, "probe": {} },
      "image_digest": null,
      "settings_state": "default"
    },
    "build-probe": {
      "enabled": false,
      "runs_untrusted": true,
      "sandbox_sha": null,
      "repo": "isokron-ai/mcp-check",
      "file": "build-probe.yml",
      "ref": "main",
      "shard_size": 2,
      "setup_minutes": 5,
      "minutes_per_subject": 20,
      "slots_max": 2,
      "versions": { "tool": {}, "oracle": {}, "probe": {} },
      "image_digest": null,
      "settings_state": "default"
    },
    "writecheck": {
      "enabled": true,
